{
	"extends": "@vue/tsconfig/tsconfig.dom.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"types": ["vite/client"],
		"allowArbitraryExtensions": true,

		/* Matches the alias in vite.config.ts. Paths resolve relative to this
		   file, so no deprecated baseUrl is needed. */
		"paths": {
			"@/*": ["./src/*"]
		},

		/* Linting */
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true
	},
	"include": ["src/**/*.ts", "shared/**/*.ts", "src/**/*.tsx", "src/**/*.vue"]
}
