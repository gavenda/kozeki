{
	"name": "kozeki",
	"version": "3.2.0",
	"private": true,
	"type": "module",
	"description": "Kozeki's book library on the web, running entirely on Cloudflare.",
	"author": "Enda <enda@gavenda.dev>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gavenda/kozeki.git",
		"directory": "webapp"
	},
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "concurrently --kill-others --names api,web --prefix-colors cyan,magenta \"bun run dev:api\" \"bun run dev:web\"",
		"dev:api": "wrangler dev --port 8788 --assets public",
		"dev:web": "vite",
		"build": "vite build",
		"preview": "bun run build && wrangler dev --port 8788",
		"deploy": "bun run build && wrangler deploy",
		"test": "bun run test:web && bun run test:server",
		"test:web": "vitest run --config vitest.config.ts",
		"test:server": "vitest run --config vitest.server.config.ts",
		"typecheck": "$(command -v npx) vue-tsc -b && tsc -p tsconfig.server.json --noEmit",
		"format": "prettier --write \"**/*.{ts,vue,json,jsonc,css,html,md}\"",
		"cf-typegen": "wrangler types",
		"db:migrate:local": "wrangler d1 migrations apply kozeki --local",
		"db:migrate": "wrangler d1 migrations apply kozeki --remote"
	},
	"dependencies": {
		"@auth0/auth0-vue": "^2",
		"@fontsource-variable/google-sans-flex": "^5.3.1",
		"@vueuse/core": "^15.0.0",
		"hono": "^4.6.14",
		"pinia": "^4.0.3",
		"vue": "^3.5.42",
		"vue-router": "^5.3.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^26.6.4",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/tsconfig": "^0.9.1",
		"concurrently": "^10.0.5",
		"happy-dom": "^20.14.5",
		"prettier": "^3.4.2",
		"tailwindcss": "^4.0.0",
		"typescript": "~6.0.2",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "~4.1.0",
		"vue-tsc": "^3.3.11",
		"workbox-build": "^7.4.1",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.131.2"
	}
}
