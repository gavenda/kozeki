# Public configuration for the browser. These values are baked into the built
# bundle and are not secrets: a SPA cannot keep one.

# The Auth0 tenant (its custom domain).
VITE_AUTH0_DOMAIN=auth.gavenda.dev
# The "Kozeki" Single Page Application, from Auth0 → Applications.
VITE_AUTH0_CLIENT_ID=ffQ0fnJKI81agEHeajej9RPVdA8Fa9Sb
# Must equal AUTH0_AUDIENCE in wrangler.jsonc.
VITE_AUTH0_AUDIENCE=https://kozeki.gavenda.dev/api

# The Hardcover OAuth application registered for the web app, with
# https://kozeki.gavenda.dev/hardcover (and http://localhost:5173/hardcover)
# as its redirect URIs. Left blank, the web app looks books up on Google Books only.
VITE_HARDCOVER_CLIENT_ID=
