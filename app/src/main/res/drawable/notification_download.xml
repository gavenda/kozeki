<?xml version="1.0" encoding="utf-8"?>
<!-- The status bar icon of chapter downloads: download_48px's arrow falling into the tray. The status bar plays an animation-list, not an animated vector. -->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="false">
    <item android:drawable="@drawable/notification_download_00" android:duration="400" />
    <item android:drawable="@drawable/notification_download_01" android:duration="110" />
    <item android:drawable="@drawable/notification_download_02" android:duration="110" />
    <item android:drawable="@drawable/notification_download_03" android:duration="110" />
    <item android:drawable="@drawable/notification_download_04" android:duration="110" />
    <item android:drawable="@drawable/notification_download_05" android:duration="110" />
</animation-list>
