<?xml version="1.0" encoding="utf-8"?>
<!--
   The halo on the launch screen, drawing itself in: the rings run round from the top, then the
   second hand swings from twelve to three. It is the halo of ui/components/Halo.kt, 120dp across,
   and its measures are that file's fractions of a radius of 60. The launch screen shows only the
   middle two thirds of what it is given, which is what the room around it is for.

   The system gives an animated icon at least 400ms on screen, and this one is done in 500.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <path
                android:name="outer_ring"
                android:pathData="M144,86.76A57.24,57.24 0,1 1,144 201.24A57.24,57.24 0,1 1,144 86.76"
                android:strokeColor="@color/halo"
                android:strokeWidth="5.52"
                android:trimPathEnd="0" />
            <path
                android:name="inner_ring"
                android:pathData="M144,95.7A48.3,48.3 0,1 1,144 192.3A48.3,48.3 0,1 1,144 95.7"
                android:strokeColor="@color/halo"
                android:strokeWidth="2.28"
                android:trimPathEnd="0" />
            <path
                android:name="ties"
                android:pathData="M144,95.7V86.76M192.3,144H201.24M144,192.3V201.24M95.7,144H86.76"
                android:strokeAlpha="0"
                android:strokeColor="@color/halo"
                android:strokeWidth="3.66" />
            <path
                android:name="dial"
                android:pathData="M144,111.24A32.76,32.76 0,1 1,144 176.76A32.76,32.76 0,1 1,144 111.24"
                android:strokeColor="@color/halo"
                android:strokeWidth="3"
                android:trimPathEnd="0" />
            <path
                android:name="hub"
                android:pathData="M144,137.82A6.18,6.18 0,1 1,144 150.18A6.18,6.18 0,1 1,144 137.82"
                android:strokeAlpha="0"
                android:strokeColor="@color/halo"
                android:strokeWidth="3.18" />
            <path
                android:name="first_hand"
                android:pathData="M144,137.82V111.24"
                android:strokeColor="@color/halo"
                android:strokeWidth="3.66"
                android:trimPathEnd="0" />
            <group
                android:name="second_hand_turn"
                android:pivotX="144"
                android:pivotY="144">
                <path
                    android:name="second_hand"
                    android:pathData="M144,137.82V111.24"
                    android:strokeColor="@color/halo"
                    android:strokeWidth="3.66"
                    android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="outer_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="inner_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="400"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="ties">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="150"
                android:propertyName="strokeAlpha"
                android:startOffset="300"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="dial">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="350"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="hub">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="150"
                android:propertyName="strokeAlpha"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="first_hand">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="50"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="second_hand">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="trimPathEnd"
                android:startOffset="50"
                android:valueFrom="0"
                android:valueTo="1" />
        </aapt:attr>
    </target>
    <target android:name="second_hand_turn">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="250"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="rotation"
                android:startOffset="250"
                android:valueFrom="0"
                android:valueTo="90" />
        </aapt:attr>
    </target>
</animated-vector>
