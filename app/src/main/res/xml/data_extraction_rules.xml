<?xml version="1.0" encoding="utf-8"?>
<!--
   What is backed up and what moves to a new device.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
           Cloud backup is capped at 25 MB per app, which a handful of EPUBs would exceed and then
           nothing would be backed up at all. The records and covers are kept; a restored book
           shows as missing its file until the EPUB is imported again.
        -->
        <exclude domain="file" path="books/" />
    </cloud-backup>
    <!-- A direct device-to-device transfer has no such cap, so the EPUBs come along. -->
    <device-transfer>
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
